          "translate_core_errors"
        ]
      }
    }
  },
  "ecosystem_consumers": {
    "Yasin-Agent": {
      "id": "Yasin-Agent",
      "role": "agent_runtime_platform",
      "import_boundary": "yasin_core.sdk",
      "compatibility_expectation": "Consume BaseAgent, Task, AgentRuntime, memory/context helpers, and YasinCoreClient via public SDK only.",
      "validator": "AgentCompatibilityValidator",
      "core_version_compat": "^3.0.0",
      "status": "documented"
    },
    "YasinHub": {
      "id": "YasinHub",
      "role": "integration_hub",
      "import_boundary": "yasin_core.sdk",
      "compatibility_expectation": "Hub metadata must include id, version, core_version_compat; consume SDK public surface only.",
      "validator": "HubCompatibilityValidator",
      "core_version_compat": "*",
      "status": "documented"
    },
    "YasinRelay": {
      "id": "YasinRelay",
      "role": "relay_transport_feed",
      "import_boundary": "yasin_core.sdk",
      "compatibility_expectation": "Relay components implement process/publish and declare core_version_compat; no Core internal imports.",
      "validator": "RelayCompatibilityValidator",
      "core_version_compat": "*",
      "status": "documented"
    },
    "YasinCLI": {
      "id": "YasinCLI",
      "role": "command_line_interface",
      "import_boundary": "yasin_core.sdk",
      "compatibility_expectation": "CLI metadata includes commands dict and core_version_compat; commands go through SDK client.",
      "validator": "CLICompatibilityValidator",
      "core_version_compat": "^3.0.0",
      "status": "documented"
    }
  },
  "compatibility": {
    "python_requires": ">=3.9",
    "certified_python_versions": [
      "3.9",
      "3.10",
      "3.11",
      "3.12",
      "3.13"
    ],
    "ci_primary_matrix": [
      "3.9",
      "3.12"
    ],
    "notes": "certified_python_versions is the authoritative set used by the extended matrix workflow. 3.14 is not certified."
  },
  "validation": {
    "schema_required_top_level": [
      "contract_version",
      "core_version",
      "status",
      "public_sdk",
      "ecosystem_consumers",
      "compatibility"
    ],
    "regression_tests": "tests/test_sdk_contract.py"
  }
}
