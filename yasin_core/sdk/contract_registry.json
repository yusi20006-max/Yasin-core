{
  "contract_version": "1.0.0",
  "core_version": "3.3.0",
  "status": "stable",
  "description": "Canonical machine-checkable public SDK and ecosystem contract registry for Yasin-Core. Single source of truth for public surface and consumer boundaries.",
  "public_sdk": {
    "package": "yasin_core.sdk",
    "supported_import_boundary": [
      "yasin_core.sdk"
    ],
    "forbidden_consumer_import_prefixes": [
      "yasin_core.agents",
      "yasin_core.api",
      "yasin_core.compatibility",
      "yasin_core.config",
      "yasin_core.context",
      "yasin_core.core",
      "yasin_core.di",
      "yasin_core.events",
      "yasin_core.execution",
      "yasin_core.memory",
      "yasin_core.observability",
      "yasin_core.plugins",
      "yasin_core.providers",
      "yasin_core.runtime",
      "yasin_core.security",
      "yasin_core.storage",
      "yasin_core.utils"
    ],
    "note": "Ecosystem consumers must import only from yasin_core.sdk. Direct imports of internal packages listed in forbidden_consumer_import_prefixes are outside the supported contract.",
    "modules": {
      "yasin_core.sdk": {
        "exports": [
          "AGENT_REGISTERED",
          "AGENT_REMOVED",
          "AGENT_STARTED",
          "AGENT_STOPPED",
          "AIChatMessage",
          "AIProvider",
          "AIProviderAuthError",
          "AIProviderConnectionError",
          "AIProviderError",
          "AIProviderRateLimitError",
          "AIRequest",
          "AIResponse",
          "AIResponseChunk",
          "APICompatibilityChecker",
          "APICompatibilityError",
          "AccessDeniedError",
          "AgentCompatibilityValidator",
          "AgentRuntime",
          "AsyncYasinCoreClient",
          "AuditLogger",
          "AuthenticationError",
          "BaseAgent",
          "BaseCredentialStore",
          "BaseDistributedWorker",
          "BaseMetricProvider",
          "BasePolicy",
          "BaseStorage",
          "BaseTool",
          "CLICompatibilityValidator",
          "CircularDependencyError",
          "CompatibilityError",
          "CompatibilityManager",
          "ConfigurationManager",
          "ConfigurationMigrator",
          "ConfigurationSecurityValidator",
          "ConfigurationValidationError",
          "ContextEngine",
          "Counter",
          "DIContainer",
          "DIError",
          "DataMigrator",
          "DefaultRBACPolicy",
          "DependencyResolutionError",
          "DeprecationManager",
          "DistributedWorkerManager",
          "EcosystemValidationError",
          "ErrorRecord",
          "ErrorTracker",
          "Event",
          "EventBus",
          "ExecutionTask",
          "FunctionTool",
          "Gauge",
          "Histogram",
          "HubCompatibilityValidator",
          "IAgentRuntime",
          "IDIContainer",
          "ISDKAuthenticator",
          "ISDKClient",
          "InMemoryCredentialStore",
          "InMemoryMetricProvider",
          "InMemoryStorage",
          "JOB_CANCELLED",
          "JOB_COMPLETED",
          "JOB_FAILED",
          "JOB_QUEUED",
          "JOB_RETRYING",
          "JOB_STARTED",
          "JSONFileStorage",
          "JSONFormatter",
          "Job",
          "JobPriority",
          "JobStatus",
          "LegacyAPIAdapter",
          "LocalProvider",
          "Metric",
          "MetricType",
          "MetricsRegistry",
          "MigrationError",
          "MockProvider",
          "ObservabilityService",
          "OpenAICompatibleProvider",
          "OrchestratorError",
          "PerformanceTimer",
          "Permission",
          "PermissionValidationError",
          "PluginExecutionBridge",
          "PolicyEngine",
          "ProviderManager",
          "ProviderRegistry",
          "RelayCompatibilityValidator",
          "Role",
          "RuntimeCompatibilityChecker",
          "RuntimeContext",
          "RuntimeOrchestrator",
          "RuntimeState",
          "SDKAuthenticationError",
          "SDKConnectionError",
          "SDKDeprecationWarning",
          "SDKError",
